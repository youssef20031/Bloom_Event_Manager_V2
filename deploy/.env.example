# Copy to deploy/.env and fill in. deploy/.env is gitignored. Never commit real values.
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
GEMINI_API_KEY=
APP_AUTH_USER=bloom
APP_AUTH_PASSWORD=change-me-to-something-long
# Generate with: openssl rand -base64 32. The Config Server's decrypt key --
# INTERNAL_SERVICE_TOKEN and GOOGLE_CLIENT_SECRET now live in config-repo as
# {cipher} ciphertext, decrypted with this key before being served.
ENCRYPT_KEY=
# Optional; blank = ephemeral dev keys (tokens die with the gateway process)
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
GOOGLE_CLIENT_ID=
GOOGLE_DRIVE_FOLDER_ID=
PDF_DIRECTORY=./pdfs

# ── Optional ────────────────────────────────────────────────────────────────
# Unset or blank = the application default shown (Compose's ${VAR:-default}
# treats an empty value as unset). Uncomment only to change one.
#
# api-gateway: lifetime of an issued login token (ISO-8601 duration).
# JWT_TTL=PT12H
#
# ai-service: generation model, then the models tried in order when it fails.
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash-001
# ai-service: embedding model; must still produce the 3072-dim vectors already stored.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
#
# chat-service and retrieval-service: chunks retrieved per question (1-100).
# RAG_TOP_K=15
#
# chat-service: Mongo database for chat sessions (set to V1's to reuse its sessions).
# MONGO_CHAT_DB=chatdb
#
# storage-service: Mongo database for the Drive OAuth token (set to V1's to reuse its token).
# MONGO_TOKEN_DB=tokendb
#
# storage-service: Drive auto-sync poll period (min 10000), and the wait before the first poll at boot.
# DRIVE_SYNC_INTERVAL_MS=300000
# DRIVE_SYNC_INITIAL_DELAY_MS=60000
