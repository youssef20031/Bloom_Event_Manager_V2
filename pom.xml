<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.bloom.eventmanager</groupId>
    <artifactId>bloom-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Bloom Event Manager V2</name>
    <description>Spring microservices rebuild of the Bloom Event Manager</description>

    <properties>
        <java.version>25</java.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
    </properties>

    <modules>
        <module>platform/bloom-bom</module>
        <module>platform/bloom-common</module>
        <module>platform/bloom-events</module>
        <module>platform/bloom-security</module>
        <module>platform/bloom-pdf</module>
        <module>infrastructure/discovery-server</module>
        <module>infrastructure/config-server</module>
        <module>services/knowledge-service</module>
        <module>services/ai-service</module>
        <module>services/retrieval-service</module>
        <module>services/ingestion-service</module>
        <module>services/storage-service</module>
        <module>services/chat-service</module>
        <module>services/proposal-service</module>
        <module>infrastructure/api-gateway</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Every Boot module declares this plugin without executions, so
                     managing it here makes all of them write
                     META-INF/build-info.properties, which /actuator/info reads. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>build-info</id>
                            <goals>
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>